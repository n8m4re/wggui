#: src/wggui/apply.py:136
msgid "Die Config wurde seit dem Lesen geändert – nichts geschrieben. Neu lesen (F5) und erneut versuchen."
msgstr "La configurazione è cambiata dopo la lettura: nessuna modifica scritta. Ricaricare (F5) e riprovare."

#: src/wggui/apply.py:137
msgid "wg syncconf fehlgeschlagen – die alte Config wurde wiederhergestellt."
msgstr "wg syncconf non riuscito: è stata ripristinata la configurazione precedente."

#: src/wggui/apply.py:138
msgid "Keine offene Änderung – der Rollback ist vermutlich schon gelaufen."
msgstr "Nessuna modifica in sospeso: il ripristino è probabilmente già avvenuto."

#: src/wggui/apply.py:139 src/wggui/provision.py:105
msgid "Auf dem Host fehlt setsid – ohne Rollback-Timer wird nichts geschrieben."
msgstr "Sul server manca setsid: senza un timer di ripristino non viene scritto nulla."

#: src/wggui/apply.py:140
msgid "Neue Config nicht erzeugt (Peer nicht gefunden?) – nichts geändert."
msgstr "Nuova configurazione non creata (peer non trovato?): nessuna modifica."

#: src/wggui/apply.py:177
msgid "Prüfsumme der Config nicht lesbar"
msgstr "Impossibile leggere il checksum della configurazione"

#: src/wggui/apply.py:202
msgid "Peer-Block anhängen"
msgstr "Aggiungi blocco peer"

#: src/wggui/apply.py:213
msgid "wg syncconf: laufender Tunnel übernimmt die Änderung, bestehende Verbindungen bleiben"
msgstr "wg syncconf: il tunnel attivo applica la modifica senza interrompere le connessioni esistenti"

#: src/wggui/apply.py:214
msgid "Interface läuft nicht: nur die Datei wird geändert, gilt beim nächsten Start"
msgstr "L'interfaccia non è attiva: viene modificato solo il file; la modifica avrà effetto al prossimo avvio"

#: src/wggui/apply.py:216
msgid "Prüfen, ob {conf_path} seit dem Lesen unverändert ist"
msgstr "Verifica che {conf_path} non sia cambiato dopo la lettura"

#: src/wggui/apply.py:217
msgid "Backup: {backup_path}"
msgstr "Backup: {backup_path}"

#: src/wggui/apply.py:218
msgid "Rollback-Timer: ohne Bestätigung nach {rollback_seconds} s Backup zurückspielen"
msgstr "Timer di ripristino: ripristina il backup dopo {rollback_seconds} s senza conferma"

#: src/wggui/apply.py:220
msgid "{action}: {conf_path} (neue Datei wird vorher geprüft)"
msgstr "{action}: {conf_path} (il nuovo file viene prima verificato)"

#: src/wggui/apply.py:223
msgid "Bestätigen (neuer SSH-Aufruf) – erst dann bleibt die Änderung"
msgstr "Conferma (nuova connessione SSH): solo allora la modifica diventa definitiva"

#: src/wggui/apply.py:231
msgid "interner Fehler: Plan unvollständig"
msgstr "errore interno: piano incompleto"

#: src/wggui/apply.py:233
msgid "Auf dem Host fehlt setsid (util-linux) – ohne Rollback-Timer schreibt die App nicht."
msgstr "Sul server manca setsid (util-linux): senza un timer di ripristino l'app non scrive nulla."

#: src/wggui/apply.py:235
msgid "Auf dem Host fehlt wg-quick – der laufende Tunnel kann nicht aktualisiert werden."
msgstr "Sul server manca wg-quick: impossibile aggiornare il tunnel attivo."

#: src/wggui/apply.py:242
msgid "Plan unvollständig"
msgstr "Piano incompleto"

#: src/wggui/apply.py:294
msgid "Geschrieben, aber nicht bestätigt: {err}\n→ {plan_host_name} spielt nach {plan_rollback_seconds} s das Backup {plan_backup_path} zurück. Danach neu lesen und erneut versuchen."
msgstr "Modifica scritta ma non confermata: {err}\n→ {plan_host_name} ripristinerà il backup {plan_backup_path} dopo {plan_rollback_seconds} s. Poi ricaricare e riprovare."

