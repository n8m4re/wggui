msgid "{action}: {conf_path} (neue Datei wird vorher geprüft)"
msgstr "{action}：{conf_path}（先检查新文件）"

#: src/wggui/apply.py:223
msgid "Bestätigen (neuer SSH-Aufruf) – erst dann bleibt die Änderung"
msgstr "确认（新建 SSH 调用）；确认后更改才会保留"

#: src/wggui/apply.py:231
msgid "interner Fehler: Plan unvollständig"
msgstr "内部错误：操作计划不完整"

#: src/wggui/apply.py:233
msgid "Auf dem Host fehlt setsid (util-linux) – ohne Rollback-Timer schreibt die App nicht."
msgstr "主机缺少 setsid（util-linux）；没有回滚计时器，应用不会写入。"

#: src/wggui/apply.py:235
msgid "Auf dem Host fehlt wg-quick – der laufende Tunnel kann nicht aktualisiert werden."
msgstr "主机缺少 wg-quick，无法更新正在运行的隧道。"

#: src/wggui/apply.py:242
msgid "Plan unvollständig"
msgstr "操作计划不完整"

#: src/wggui/apply.py:294
msgid "Geschrieben, aber nicht bestätigt: {err}\n→ {plan_host_name} spielt nach {plan_rollback_seconds} s das Backup {plan_backup_path} zurück. Danach neu lesen und erneut versuchen."
msgstr "已写入，但未确认：{err}\n→ {plan_host_name} 将在 {plan_rollback_seconds} 秒后恢复备份 {plan_backup_path}。之后请重新读取并重试。"

