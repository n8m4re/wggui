msgstr "wireguard-tools no está disponible tras la instalación."

#: src/wggui/remote.py:36
msgid "Anmeldung abgelehnt: Schlüssel nicht im SSH-Agent oder nicht in authorized_keys des Zielnutzers."
msgstr "Inicio de sesión rechazado: la clave no está en el agente SSH ni en authorized_keys del usuario de destino."

#: src/wggui/remote.py:38
msgid "Host-Key unbekannt oder geändert: einmal im Terminal `ssh <Ziel>` ausführen und den Fingerabdruck prüfen."
msgstr "Clave del host desconocida o modificada: ejecute `ssh <destino>` una vez en una terminal y compruebe la huella digital."

#: src/wggui/remote.py:40
msgid "Host-Key hat sich geändert – erst prüfen, dann den alten Eintrag mit `ssh-keygen -R <host>` entfernen."
msgstr "La clave del host ha cambiado; compruébela antes de eliminar la entrada anterior con `ssh-keygen -R <host>`."

#: src/wggui/remote.py:42
msgid "Hostname nicht auflösbar: Schreibweise, DNS oder ssh-Config prüfen."
msgstr "No se puede resolver el nombre del host: compruebe la escritura, DNS o la configuración de ssh."

#: src/wggui/remote.py:43
msgid "Port geschlossen: läuft sshd, stimmt der Port?"
msgstr "Puerto cerrado: ¿se está ejecutando sshd? ¿Es correcto el puerto?"

#: src/wggui/remote.py:44 src/wggui/remote.py:45
msgid "Keine Antwort: Host aus, Firewall oder falsches Netz (VPN?)."
msgstr "Sin respuesta: host apagado, cortafuegos o red incorrecta (¿VPN?)."

#: src/wggui/remote.py:46
msgid "Keine Route zum Host: Netz oder VPN prüfen."
msgstr "No hay ruta al host: compruebe la red o la VPN."

#: src/wggui/remote.py:47 src/wggui/remote.py:49
msgid "sudo verlangt ein Passwort: NOPASSWD für diesen Nutzer einrichten oder als root anmelden."
msgstr "sudo solicita una contraseña: configure NOPASSWD para este usuario o inicie sesión como root."

#: src/wggui/remote.py:51 src/wggui/remote.py:52
msgid "sudo ist auf dem Host nicht installiert."
msgstr "sudo no está instalado en el host."

